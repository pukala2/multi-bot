# =============================================================================
# Multibot - environment variables template
# Kopiuj do `.env` i wpisz prawdziwe klucze.
# NIE commituj `.env` - jest w .gitignore.
# =============================================================================

# ----- LLM / Embedding API keys -----
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...

# ----- Database (opcjonalne - defaults działają dla docker-compose) -----
DB_URL=jdbc:postgresql://localhost:5432/multibot
DB_USER=multibot
DB_PASSWORD=multibot

# ----- Spring profile -----
SPRING_PROFILES_ACTIVE=dev
