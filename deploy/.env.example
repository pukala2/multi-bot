# =============================================================================
# Multibot — zmienne srodowiskowe produkcyjne.
# Skopiuj na serwerze:  cp deploy/.env.example deploy/.env
# i uzupelnij PRAWDZIWYMI wartosciami. Plik .env jest w .gitignore — NIE commituj.
# =============================================================================

# --- Domena (DuckDNS albo wlasna) ---
DOMAIN=multibot-test.duckdns.org

# --- Baza danych (postgres w docker-compose) ---
DB_NAME=multibot
DB_USER=multibot
DB_PASSWORD=ZMIEN_NA_MOCNE_HASLO_DB

# --- Klucze API (produkcyjne) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Konto super admina (tworzone przy starcie) ---
MULTIBOT_SUPERADMIN_EMAIL=superadmin@multibot.local
MULTIBOT_SUPERADMIN_PASSWORD=ZMIEN_NA_MOCNE_HASLO

# --- Default tenant + jego owner (do testow) ---
MULTIBOT_DEFAULT_TENANT_BOOTSTRAP=true
MULTIBOT_DEMO_OWNER_EMAIL=owner@demo.local
MULTIBOT_DEMO_OWNER_PASSWORD=ZMIEN_NA_MOCNE_HASLO

# --- Rate limit (mozna zostawic domyslne) ---
MULTIBOT_RATE_LIMIT_IP=80
MULTIBOT_RATE_LIMIT_SESSION=60

# --- Turnstile (anti-bot) — WLACZ DOPIERO NA KONCU, po potwierdzeniu ze widget dziala ---
MULTIBOT_TURNSTILE_ENABLED=false
MULTIBOT_TURNSTILE_SITE_KEY=
MULTIBOT_TURNSTILE_SECRET_KEY=
